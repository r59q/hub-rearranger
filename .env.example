# Fine-grained GitHub token with read-only Metadata, Contents, Issues, and Actions access to the repositories you display.
GITHUB_TOKEN=

# Optional local overrides.
FRONTEND_PORT=3000
REPOSITORIES_PORT=8080
ISSUES_PORT=8081
AGENTS_PORT=8082
IDENTITY_PORT=8083
APP_ORIGIN=http://localhost:3000

# Optional GitHub App user sign-in. Set all four together; never reuse GITHUB_TOKEN.
# Register APP_ORIGIN/auth/callback as the App's callback URL.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Generate 32 random bytes, base64 encoded. Keep the key stable across restarts.
IDENTITY_ENCRYPTION_KEY=
